# ── Azure App Configuration target ────────────────────────────────────────
APP_CONFIG_NAME=myapp-config-dev
RESOURCE_GROUP=myapp-rg-dev

# ── Azure identity (for local az login --use-device-code) ────────────────
ARM_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ARM_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Terraform backend ────────────────────────────────────────────────────
TF_BACKEND_RESOURCE_GROUP=tfstate-rg
TF_BACKEND_STORAGE_ACCOUNT=tfstateXXXXX
TF_BACKEND_CONTAINER=tfstate

# ── Optional label (leave empty for no label filter) ─────────────────────
LABEL=
