#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────
#  .env — shared knobs for the entire local-LLM stack
#  Source this before any make target or agent script:
#    source .env
#
#  Hardware: Lenovo P340 SFF · i9-10900 (10C/20T) · Quadro P1000 4 GB
#            32 GB DDR4-2933 · Ubuntu 20.04
# ──────────────────────────────────────────────────────────────────────

# ── GPU / VRAM budget ────────────────────────────────────────────────
export TOTAL_VRAM_MB=4096               # Quadro P1000
export VRAM_OVERHEAD_MB=512             # reserve for X11 / Wayland / desktop
export USABLE_VRAM_MB=3584              # 4096 - 512
export VRAM_OVERHEAD_BYTES=536870912    # 512 MB in bytes (Ollama wants bytes)

# ── CPU budget ───────────────────────────────────────────────────────
export PHYSICAL_CORES=10                # i9-10900, do NOT set above this
export TOTAL_RAM_MB=32768

# ── Ollama ───────────────────────────────────────────────────────────
export OLLAMA_HOST="0.0.0.0:11434"
export OLLAMA_BASE_URL="http://127.0.0.1:11434"
export OLLAMA_MODELS="/usr/share/ollama/.ollama/models"
export OLLAMA_KEEP_ALIVE="15m"
export OLLAMA_NUM_PARALLEL=1            # 1 = safest on 4 GB
export OLLAMA_MAX_LOADED_MODELS=2       # chat + embed only
export OLLAMA_FLASH_ATTENTION=1         # required for KV quant
export OLLAMA_KV_CACHE_TYPE="q8_0"      # halves KV-cache memory
export OLLAMA_GPU_OVERHEAD="${VRAM_OVERHEAD_BYTES}"
export OLLAMA_CONTEXT_LENGTH=4096       # global default; override per model
export OLLAMA_ORIGINS="*"               # allow cross-origin (WebUI, agents)

# ── Default model selections ─────────────────────────────────────────
export MODEL_CHAT="p1000-chat"          # custom Modelfile name
export MODEL_CODE="p1000-coder"
export MODEL_AGENT="p1000-agent"
export MODEL_HEAVY="p1000-heavy"
export MODEL_EMBED="nomic-embed-text"
export MODEL_VISION="llava-phi3"

# ── LM Studio ────────────────────────────────────────────────────────
export LMS_PORT=1234
export LMS_HOST="127.0.0.1"

# ── LiteLLM proxy ───────────────────────────────────────────────────
export LITELLM_PORT=4000
export LITELLM_MASTER_KEY="sk-litellm-$(hostname)-local"

# ── SearXNG ──────────────────────────────────────────────────────────
export SEARXNG_PORT=8888
export SEARXNG_URL="http://127.0.0.1:${SEARXNG_PORT}"

# ── Open WebUI ───────────────────────────────────────────────────────
export WEBUI_PORT=3000
export WEBUI_SECRET_KEY="$(cat /proc/sys/kernel/random/uuid | tr -d '-')"

# ── Python / agent common ───────────────────────────────────────────
export TOKENIZERS_PARALLELISM=false     # silence HF warning in forked procs
export PYTHONDONTWRITEBYTECODE=1
