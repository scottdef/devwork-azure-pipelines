# ──────────────────────────────────────────────────────────────────────
#  Modelfile.code-3b — Coding assistant (Python / Go / Bash / C)
#  VRAM: ~2.4 GB (full GPU offload)
#  Build: ollama create p1000-coder -f Modelfile.code-3b
# ──────────────────────────────────────────────────────────────────────

FROM qwen2.5-coder:3b

# ── GPU / memory ─────────────────────────────────────────────────────
PARAMETER num_gpu       99
PARAMETER num_ctx       8192        # code needs longer context
PARAMETER num_predict   4096        # longer outputs for full functions

# ── CPU ──────────────────────────────────────────────────────────────
PARAMETER num_thread    10

# ── Sampling — deterministic for code ────────────────────────────────
PARAMETER temperature   0.1         # near-deterministic
PARAMETER top_p         0.95
PARAMETER top_k         20
PARAMETER repeat_penalty 1.05

# ── Stop tokens ──────────────────────────────────────────────────────
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"
PARAMETER stop "```\n\n"

# ── System prompt ────────────────────────────────────────────────────
SYSTEM """You are a senior software engineer specializing in Python 3.11,
Go, Bash, and C on Ubuntu 20.04 / Plan 9. Constraints:
- Reply with runnable code first, brief explanation second.
- Always include error handling and type hints (Python) or error returns (Go).
- Use POSIX-compliant shell when possible; avoid bashisms unless asked.
- For system-level code, prefer Plan 9 / rc-shell idioms when the user
  asks for Plan 9 compatibility.
- Say "I'm not sure" rather than fabricating library APIs.
- Target the i9-10900 (10 cores) and 32 GB RAM in performance advice."""
