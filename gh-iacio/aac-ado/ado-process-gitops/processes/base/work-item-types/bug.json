{
  "referenceName": "CoolADO.Bug",
  "name": "Bug",
  "description": "A defect that needs to be tracked and resolved",
  "color": "CC293D",
  "icon": "icon_insect",
  "inherits": "Microsoft.VSTS.WorkItemTypes.Bug",
  "fields": [
    {"referenceName": "CoolADO.RootCause", "name": "Root Cause Category", "type": "string", "description": "Classification of defect root cause", "required": false, "allowedValues": ["Code Defect","Configuration","Data Issue","Integration","Environment","Third Party","Requirements Gap"]},
    {"referenceName": "CoolADO.FoundInBuild", "name": "Found In Build", "type": "string", "description": "Build number where discovered", "required": false},
    {"referenceName": "CoolADO.Severity", "name": "Severity", "type": "string", "description": "Impact severity", "required": true, "allowedValues": ["1 - Critical","2 - High","3 - Medium","4 - Low"]}
  ],
  "states": [
    {"name": "New", "color": "b2b2b2", "stateCategory": "Proposed", "order": 1},
    {"name": "Approved", "color": "007acc", "stateCategory": "Proposed", "order": 2},
    {"name": "Committed", "color": "007acc", "stateCategory": "InProgress", "order": 3},
    {"name": "Done", "color": "339933", "stateCategory": "Completed", "order": 4},
    {"name": "Removed", "color": "ffffff", "stateCategory": "Removed", "order": 5}
  ],
  "rules": [
    {"name": "Require Severity on creation", "conditions": [{"conditionType": "whenCreated"}], "actions": [{"actionType": "makeRequired", "targetField": "CoolADO.Severity"}]},
    {"name": "Require Root Cause when Done", "conditions": [{"conditionType": "whenChanged", "field": "System.State", "value": "Done"}], "actions": [{"actionType": "makeRequired", "targetField": "CoolADO.RootCause"}]}
  ]
}
