{
  "processDescription": "CoolADOAgile PROD - production process with full compliance controls",
  "workItemTypes": {},
  "disabledWorkItemTypes": [],
  "additionalFields": {
    "CoolADO.UserStory": [
      {"referenceName": "CoolADO.ChangeTicket", "name": "Change Ticket ID", "type": "string", "description": "Associated change management ticket number", "required": false}
    ],
    "CoolADO.Bug": [
      {"referenceName": "CoolADO.IncidentRef", "name": "Incident Reference", "type": "string", "description": "Reference to incident management ticket", "required": false}
    ]
  },
  "additionalStates": {},
  "additionalRules": {
    "CoolADO.UserStory": [
      {"name": "Require Change Ticket before Closed in Prod", "conditions": [{"conditionType": "whenChanged", "field": "System.State", "value": "Closed"}], "actions": [{"actionType": "makeRequired", "targetField": "CoolADO.ChangeTicket"}]}
    ],
    "CoolADO.Bug": [
      {"name": "Require Incident Reference for Critical bugs", "conditions": [{"conditionType": "whenValueEquals", "field": "CoolADO.Severity", "value": "1 - Critical"}], "actions": [{"actionType": "makeRequired", "targetField": "CoolADO.IncidentRef"}]}
    ]
  }
}
