# Example 3: Meta Muse Glimmer 30B from your own Hugging Face repository,
# used by Copilot CLI (BYOK) and a GitHub agentic workflow.
# Custom weights here are produced elsewhere and published to a private HF
# repo; set FTM_SET_HF_REPO (or the workflow input) to it. The default is
# the public base so the example runs as shipped.
EXAMPLE_TITLE='Muse Glimmer 30B (your HF weights) for Copilot CLI and gh-aw'
LICENSE_NOTE='meta-models/Muse-Glimmer-30B is Apache-2.0 and not gated; see its USAGE_POLICY.md'

HF_REPO=meta-models/Muse-Glimmer-30B
HF_REVISION=main
# Key Vault secret with a read token, used only when KEY_VAULT_URL is set (private repos).
HF_TOKEN_SECRET=hf-token

AML_MODEL_NAME=muse-glimmer-30b
SERVED_NAME=muse-glimmer
ENDPOINT_NAME=ftm-muse-coolgit
CONNECTION_NAME=ftm-muse

# ~60 GB in BF16 with a 1.8B vision encoder: two H100s, tensor parallel 2.
INSTANCE_TYPE=Standard_NC80adis_H100_v5
INSTANCE_COUNT=1
MAX_CONCURRENT=16
# Parser names from the vLLM Muse Glimmer recipe; supported in released vLLM (v0.30.0).
VLLM_ARGS=--tensor-parallel-size 2 --max-model-len 65536 --enable-auto-tool-choice --tool-call-parser muse_glimmer --reasoning-parser muse_glimmer --generation-config auto --gpu-memory-utilization 0.92
SMOKE_KIND=tools

TRAIN_ENABLED=false
