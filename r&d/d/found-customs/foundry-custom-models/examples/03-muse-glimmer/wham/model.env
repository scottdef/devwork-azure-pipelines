# Example 3b: Microsoft Muse (WHAM), the model Foundry's catalog calls "Muse".
# Not a chat model: it predicts game frames and controller actions for
# Bleeding Edge. Research use only. No Foundry agent connection is created.
EXAMPLE_TITLE='Microsoft Muse (WHAM 1.6B) research server'
LICENSE_NOTE='Microsoft Research License: research use only. Output is watermarked; do not remove it'

HF_REPO=microsoft/wham
HF_REVISION=main
# Code, config and the 1.6B checkpoint; skip the demonstrator app and the 200M model.
FETCH_INCLUDE=*.py,*.txt,*.md,configs/*,wham/*,models/config.json,models/WHAM_1.6B_v1.ckpt

AML_MODEL_NAME=wham
SERVED_NAME=wham
ENDPOINT_NAME=ftm-wham-coolgit
CONNECTION_NAME=ftm-wham

INSTANCE_TYPE=Standard_NC24ads_A100_v4
INSTANCE_COUNT=1
MAX_CONCURRENT=4
SERVE_ENV=ftm-wham
SMOKE_KIND=http
SMOKE_PATH=/get_job_results?job_ids=ftm-smoke

TRAIN_ENABLED=false
