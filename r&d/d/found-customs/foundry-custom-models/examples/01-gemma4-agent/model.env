# Example 1: Gemma 4, fine-tuned and merged, served to a Foundry prompt agent.
EXAMPLE_TITLE='Gemma 4 E4B runbook assistant (LoRA merged) for Foundry agents'
LICENSE_NOTE='google/gemma-4-E4B-it is Apache-2.0 and not gated'

HF_REPO=google/gemma-4-E4B-it
# Pin to a commit for production; workflows resolve 'main' to one before planning.
HF_REVISION=main

AML_MODEL_NAME=gemma4-e4b-coolgit
SERVED_NAME=gemma4-coolgit
ENDPOINT_NAME=ftm-gemma4-coolgit
CONNECTION_NAME=ftm-gemma4

# One A100 80GB. E4B in BF16 is ~16 GB; the rest is KV cache.
# For google/gemma-4-31B-it use Standard_NC80adis_H100_v5 and --tensor-parallel-size 2.
INSTANCE_TYPE=Standard_NC24ads_A100_v4
INSTANCE_COUNT=1
MAX_CONCURRENT=16
# Flags from the vLLM Gemma 4 recipe. The tool template ships in the vLLM image.
VLLM_ARGS=--max-model-len 32768 --enable-auto-tool-choice --tool-call-parser gemma4 --reasoning-parser gemma4 --chat-template /vllm-workspace/examples/tool_chat_template_gemma4.jinja --gpu-memory-utilization 0.90
SMOKE_KIND=tools

TRAIN_ENABLED=true
TRAIN_MODE=merge
TRAIN_DATA=data/train.jsonl
TRAIN_COMPUTE=gpu-a100
EPOCHS=3
LORA_R=16
MAX_SEQ_LEN=2048
