# Example 2: Qwen3.8-27B base plus a LoRA adapter served side by side,
# driven by a Microsoft Agent Framework harness and workflow.
# Qwen3.7 shipped as API-only models (Plus, Max); Qwen3.8-27B is the newest
# open-weight Qwen that is Apache-2.0. Qwen/Qwen3.6-27B is a drop-in fallback.
EXAMPLE_TITLE='Qwen3.8-27B with a coolgit-ops LoRA adapter for an Agent Framework harness'
LICENSE_NOTE='Qwen/Qwen3.8-27B is Apache-2.0 and not gated (the 2.4T-A95B and Flash-Next repos use other licenses)'

HF_REPO=Qwen/Qwen3.8-27B
HF_REVISION=main

AML_MODEL_NAME=qwen38-27b-coolgit
SERVED_NAME=qwen38-27b
ENDPOINT_NAME=ftm-qwen38-coolgit
CONNECTION_NAME=ftm-qwen38

# 27.8B parameters, ~56 GB in BF16: one H100 80GB with an FP8 KV cache.
INSTANCE_TYPE=Standard_NC40ads_H100_v5
INSTANCE_COUNT=1
MAX_CONCURRENT=16
# qwen3_xml is the tool parser in the vLLM Qwen3.8 recipe. Thinking stays on;
# the harness turns it off per request where it wants short answers.
VLLM_ARGS=--max-model-len 32768 --kv-cache-dtype fp8 --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --max-loras 2 --gpu-memory-utilization 0.92
SMOKE_KIND=tools

TRAIN_ENABLED=true
TRAIN_MODE=adapter
ADAPTER_NAME=coolgit-ops
TRAIN_DATA=data/train.jsonl
# Two H100s: 56 GB of frozen BF16 weights plus activations with checkpointing.
TRAIN_COMPUTE=gpu-h100x2
EPOCHS=2
LORA_R=16
MAX_SEQ_LEN=4096
