$schema: https://azuremlschemas.azureedge.net/latest/managedOnlineDeployment.schema.json
# One deployment per served model version; the name is derived from it, so a
# re-run with nothing changed finds the deployment already there.
name: @{DEPLOYMENT_NAME}
endpoint_name: @{ENDPOINT_NAME}
model: azureml:@{SERVE_MODEL_NAME}:@{SERVE_MODEL_VERSION}
model_mount_path: /models
environment: azureml:@{SERVE_ENV}:@{SERVE_ENV_VERSION_USED}
instance_type: @{INSTANCE_TYPE}
instance_count: @{INSTANCE_COUNT}
environment_variables:
  SERVED_MODEL_NAME: '@{SERVED_NAME}'
  MODEL_ROOT: /models
  VLLM_ARGS: '@{VLLM_ARGS}'
request_settings:
  # 180000 ms is the managed online endpoint ceiling; long generations must stream.
  request_timeout_ms: 180000
  max_concurrent_requests_per_instance: @{MAX_CONCURRENT}
# Loading 30B of weights and compiling CUDA graphs takes minutes, not seconds.
liveness_probe:
  initial_delay: 900
  period: 30
  timeout: 10
  failure_threshold: 30
readiness_probe:
  initial_delay: 300
  period: 10
  timeout: 10
  failure_threshold: 120
tags:
  hf_repo: '@{HF_REPO}'
  hf_revision: '@{HF_REVISION}'
  client_model: '@{CLIENT_MODEL}'
