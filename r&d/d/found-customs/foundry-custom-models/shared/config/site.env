# Site settings shared by every example. Workflows override these from
# repository variables of the same name; locally, export them.
AZURE_RESOURCE_GROUP=rg-coolgit-copilot
AZURE_LOCATION=eastus2
AML_WORKSPACE=mlw-coolgit-foundry
FOUNDRY_ACCOUNT=ais-coolgit-copilot-prod
FOUNDRY_PROJECT=proj-coolgit-agents
# CPU cluster for Hub downloads; GPU cluster names live in each model.env.
FETCH_COMPUTE=cpu-fetch
# Key Vault holding the Hugging Face token for private or gated repos.
# Leave empty for public, ungated weights (all three bases are ungated).
KEY_VAULT_URL=
# The vLLM version is pinned once, in shared/containers/*/Dockerfile (ARG VLLM_IMAGE).
