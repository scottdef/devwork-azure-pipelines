{{- /* Shared partials. Names are stable; override this file to re-brand. */ -}}

{{- define "request-table" -}}
| Field | Value |
| ----- | ----- |
{{- range .Rows }}
| {{ .Label }} | {{ if .Code }}{{ code .Value }}{{ else }}{{ cell .Value }}{{ end }} |
{{- end }}
