{
  "uid": "issueops-ops",
  "title": "IssueOps / Platform operations",
  "tags": [
    "issueops"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "graphTooltip": 1,
  "description": "Published hourly by the ops-metrics workflow (issueops ops-metrics --deep).",
  "templating": {
    "list": [
      {
        "name": "org",
        "label": "Organization",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "issueops-prometheus"
        },
        "query": {
          "query": "label_values(issueops_requests, org)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(issueops_requests, org)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "type",
        "label": "Request type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "issueops-prometheus"
        },
        "query": {
          "query": "label_values(issueops_requests{org=\"$org\"}, type)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(issueops_requests{org=\"$org\"}, type)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Awaiting approval",
      "description": "Submitted requests waiting for approvers.",
      "datasource": {
        "type": "prometheus",
        "uid": "issueops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "issueops-prometheus"
          },
          "expr": "sum(issueops_requests{org=\"$org\",type=~\"$type\",phase=\"submitted\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
