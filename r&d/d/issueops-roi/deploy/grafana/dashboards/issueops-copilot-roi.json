  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "graphTooltip": 1,
  "description": "Published by copilot-usage-report requests with 'Publish metrics to Grafana'. Values are for each report's window; pick a request to see one report.",
  "templating": {
    "list": [
      {
        "name": "org",
        "label": "Organization",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "issueops-prometheus"
        },
        "query": {
          "query": "label_values(issueops_copilot_total_cost_usd, org)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(issueops_copilot_total_cost_usd, org)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "request",
        "label": "Report request",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "issueops-prometheus"
        },
        "query": {
          "query": "label_values(issueops_copilot_total_cost_usd{org=\"$org\"}, request)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(issueops_copilot_total_cost_usd{org=\"$org\"}, request)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
