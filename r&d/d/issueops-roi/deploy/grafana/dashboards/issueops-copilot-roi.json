      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "issueops-prometheus"
          },
          "expr": "sum(issueops_copilot_total_cost_usd{org=\"$org\",request=~\"$request\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
