# Single source of configuration. Sourced by every script.
ENTERPRISE="CoolGitEnterprise"            # enterprise slug, as in /enterprises/<slug>
ORG="CoolGitOrg"
ALLOWED_TEAMS="copilot-power-users platform-engineering"   # team slugs; member of ANY may request
APPROVER_TEAM="issueops-bureaucraticops"
APP_BOT_LOGIN="issueops-autoadmin-app[bot]"

# Units. The budgets API takes whole US dollars; 1 AI credit = $0.01.
#   CENTS_PER_UNIT=100  a unit is one dollar:  +50 = $50 = 5000 AI credits   (default)
#   CENTS_PER_UNIT=1    a unit is one credit:  +50 = $0.50 -> refused, not a whole dollar
CENTS_PER_UNIT=100
STEP=50                                   # increment, in units
MAX=300                                   # ceiling on the RESULTING budget, in units
BASELINE=0                                # units assumed when no budget of any kind covers the user

CYCLE_DAY=1                               # day of month usage resets, UTC, 1..28
OVERRIDE_EXPIRES=""                       # optional YYYY-MM-DD; the override lapses on this date
API_VERSION="2026-03-10"
