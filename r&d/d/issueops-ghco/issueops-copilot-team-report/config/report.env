# Single source of configuration. Sourced by the shell scripts, read from the
# environment by the Python ones.
ENTERPRISE="CoolGitEnterprise"
ORG="CoolGitOrg"
APP_BOT_LOGIN="issueops-autoadmin-app[bot]"
REPORT_WORKFLOW="copilot-team-report.lock.yml"   # the compiled agentic workflow

# Who may ask. A maintainer of team X may ask about team X.
# Members of REPORT_ADMINS_TEAM may ask about any team. Empty disables the override.
REPORT_ADMINS_TEAM="copilot-admins"
MIN_TEAM_SIZE=5            # GitHub omits teams under 5 seated users from its own team reports; so do we
ALLOWED_DAYS="7 14 28"     # the usage report is a rolling 28-day file; shorter windows are cut from it

# What counts.
PROD_ENV_REGEX='^(prod|production)$'             # deployment environment names, case-insensitive
COPILOT_BOTS="copilot-swe-agent[bot] Copilot"    # PR authors that are the Copilot cloud agent
MAX_REPOS=150              # team repositories scanned for PRs and deployments

# Money. 1 AI credit = US$0.01. Seats fund the included credit pool, so seat cost is
# shown beside credit cost, never added to it. 0 hides it.
CREDIT_USD=0.01
SEAT_USD_MONTH=0

# Tiers, in Copilot events per calendar day over the window.
# event = user-initiated interaction + code generation. Tune to your org; these are a start.
TIER_POWER=50
TIER_HEAVY=20
TIER_MEDIUM=5

RETENTION_DAYS=14          # how long the report artifact lives
API_VERSION="2026-03-10"
