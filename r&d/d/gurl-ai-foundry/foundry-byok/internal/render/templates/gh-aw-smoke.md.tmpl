---
# Generated by foundry-byok. Do not edit; change the inventory and regenerate.
# Compile with: gh aw compile --strict   (commit both this file and the .lock.yml)
{{- range .WarningsFor "gh-aw"}}
# WARNING: {{.}}
{{- end}}
name: {{printf "Smoke: Foundry BYOK %s (%s)" .Spec.Deployment (or .Spec.Environment "default") | yamlq}}
on:
  workflow_dispatch:
permissions:
  contents: read
{{- if eq (print .Spec.Auth) "entra"}}
  id-token: write
{{- end}}
{{- if .Spec.RunsOn}}
runs-on: {{runsOn .Spec.RunsOn}}
{{- end}}
timeout-minutes: 10
engine:
  id: copilot
  model: {{.GhAw.EngineModel | yamlq}}
{{- if eq (print .Spec.Auth) "entra"}}
  auth:
    type: github-oidc
    provider: azure
    azure-tenant-id: {{.Spec.TenantID | yamlv}}
    azure-client-id: {{.Spec.ClientID | yamlv}}
{{- end}}
  env:
    COPILOT_PROVIDER_BASE_URL: {{.GhAw.ProviderBaseURL | yamlq}}
{{- if .GhAw.APIKeyExpr}}
    COPILOT_PROVIDER_API_KEY: {{.GhAw.APIKeyExpr}}
{{- end}}
{{- if .GhAw.ProviderType}}
    COPILOT_PROVIDER_TYPE: {{.GhAw.ProviderType | yamlq}}
{{- end}}
{{- if .GhAw.ProviderModelID}}
    COPILOT_PROVIDER_MODEL_ID: {{.GhAw.ProviderModelID | yamlq}}
{{- end}}
{{- if eq (print .GhAw.WireAPI) "responses"}}
    COPILOT_PROVIDER_WIRE_API: responses
{{- end}}
network:
  allowed:
{{- range .GhAw.NetworkAllowed}}
    - {{.}}
{{- end}}
{{- if .Spec.DisableModelFallback}}
sandbox:
  agent:
    id: awf
    model-fallback: false
{{- end}}
---

# Foundry BYOK smoke test

This is a connectivity check for the Azure AI Foundry deployment
`{{.Spec.Deployment}}` on `{{.Host}}`. Do not read, create or modify any
repository content.

1. Work out 17 + 25.
2. Call the `noop` tool exactly once with this message, replacing `N` with
   your answer: `FOUNDRY_BYOK_OK deployment={{.Spec.Deployment}} result=N`

Do not create issues, comments, discussions or pull requests. Calling `noop`
is mandatory: a run that ends without any safe-output call is reported as a
failure.
