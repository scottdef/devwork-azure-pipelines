# Generated by foundry-byok. Do not edit; change the inventory and regenerate.
#
# gh-aw frontmatter fragment: route the Copilot engine to Azure AI Foundry
# deployment {{.Spec.Deployment | yamlq}} ({{or .Spec.Environment "-"}}).
# Merge these keys into the frontmatter of any agentic workflow, then run:
#   gh aw compile --strict
#
# Reference: https://github.github.com/gh-aw/reference/azure-openai-byok/
{{- range .WarningsFor "gh-aw"}}
# WARNING: {{.}}
{{- end}}
{{- if eq (print .Spec.Auth) "entra"}}
permissions:
  id-token: write            # GitHub OIDC -> Microsoft Entra federation
{{- end}}
engine:
  id: copilot
  # engine.model compiles to COPILOT_MODEL. It must be a model ID returned by
  # GET {{.ModelsURLHint}}
  model: {{.GhAw.EngineModel | yamlq}}
{{- if eq (print .Spec.Auth) "entra"}}
  auth:
    type: github-oidc
    provider: azure
    azure-tenant-id: {{.Spec.TenantID | yamlv}}
    azure-client-id: {{.Spec.ClientID | yamlv}}
{{- end}}
  env:
    COPILOT_PROVIDER_BASE_URL: {{.GhAw.ProviderBaseURL | yamlq}}
{{- if .GhAw.APIKeyExpr}}
    # Credentials belong in engine.env (not top-level secrets:); the AWF proxy
    # sidecar holds the real key and the agent only sees a placeholder.
    COPILOT_PROVIDER_API_KEY: {{.GhAw.APIKeyExpr}}
{{- end}}
{{- if .GhAw.ProviderType}}
    COPILOT_PROVIDER_TYPE: {{.GhAw.ProviderType | yamlq}}
{{- end}}
{{- if .GhAw.ProviderModelID}}
    # The Azure deployment name differs from the model ID, so send it on the wire.
    COPILOT_PROVIDER_MODEL_ID: {{.GhAw.ProviderModelID | yamlq}}
{{- end}}
{{- if eq (print .GhAw.WireAPI) "responses"}}
    # Required for GPT-5 and o-series deployments (the CLI defaults to completions).
    COPILOT_PROVIDER_WIRE_API: responses
{{- end}}
network:
  allowed:
{{- range .GhAw.NetworkAllowed}}
    - {{.}}
{{- end}}
{{- if .Spec.DisableModelFallback}}
# Documented workaround when the AWF proxy rewrites the deployment name and
# Azure answers HTTP 404.
sandbox:
  agent:
    id: awf
    model-fallback: false
{{- end}}
