#!/usr/bin/env bash
# Generated by foundry-byok. Do not edit; change the inventory and regenerate.
#
# Direct API calls for Azure AI Foundry deployment {{.Spec.Deployment | shq}}
#   environment : {{or .Spec.Environment "-"}}
#   host        : {{.Host}}
#   model ID    : {{.ModelID}}
#   surface     : {{.Surface}}{{if .WireAPI}} (preferred wire API: {{.WireAPI}}){{end}}
#
# Usage: ./curl.sh [{{if eq (print .Surface) "anthropic"}}messages{{else}}models|chat|responses|legacy|all{{end}}]
#
# Auth (first match wins):
#   AZURE_FOUNDRY_BEARER_TOKEN  Entra ID token for scope {{.EntraScope}}
#   {{.KeyEnv}}  resource API key
# Get a token with:
#   az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
set -euo pipefail

PROMPT="${PROMPT:-Reply with the single word: pong}"

if [[ -n "${AZURE_FOUNDRY_BEARER_TOKEN:-}" ]]; then
  AUTH_HEADER="Authorization: Bearer ${AZURE_FOUNDRY_BEARER_TOKEN}"
elif [[ -n "{{shvar .KeyEnv ":-"}}" ]]; then
  AUTH_HEADER="{{if eq (print .Surface) "anthropic"}}x-api-key{{else}}api-key{{end}}: {{shvar .KeyEnv ""}}"
else
  echo "error: export AZURE_FOUNDRY_BEARER_TOKEN or {{.KeyEnv}}" >&2
  exit 2
fi

# -M keeps jq output free of ANSI colour codes when it is captured by CI.
pretty() { if command -v jq >/dev/null 2>&1; then jq -M .; else cat; fi; }

call() { # call METHOD URL [BODY]
  local method="$1" url="$2" body="${3:-}"
  local args=(-sS --fail-with-body --max-time 120 -X "$method" "$url" -H "$AUTH_HEADER")
{{- if eq (print .Surface) "anthropic"}}
  args+=(-H "anthropic-version: 2023-06-01")
{{- end}}
  if [[ -n "$body" ]]; then args+=(-H "Content-Type: application/json" --data "$body"); fi
  echo ">>> $method $url" >&2
  curl "${args[@]}" | pretty
}

json_prompt() { printf '%s' "$PROMPT" | if command -v jq >/dev/null 2>&1; then jq -MRs .; else sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'; fi; }
{{if eq (print .Surface) "anthropic"}}
# Foundry-hosted Anthropic Messages API. "model" is the deployment name.
do_messages() {
  call POST {{.URLs.AnthropicMessages | shq}} "$(cat <<JSON
{"model": {{.Spec.Deployment | jsonq}}, "max_tokens": 64,
 "messages": [{"role": "user", "content": $(json_prompt)}]}
JSON
)"
}

case "${1:-messages}" in
  messages|all) do_messages ;;
  *) echo "usage: $0 [messages]" >&2; exit 2 ;;
esac
{{- else}}
# GET /openai/v1/models lists the model IDs this resource exposes. gh-aw's
# engine.model must be one of them ({{.ModelID}} is expected).
do_models() { call GET {{.URLs.V1Models | shq}}; }

# v1 API: unversioned URL; the *deployment name* travels in "model".
do_chat() {
  call POST {{.URLs.V1ChatCompletions | shq}} "$(cat <<JSON
{"model": {{.Spec.Deployment | jsonq}},
 "messages": [{"role": "user", "content": $(json_prompt)}]}
JSON
)"
}

do_responses() {
  call POST {{.URLs.V1Responses | shq}} "$(cat <<JSON
{"model": {{.Spec.Deployment | jsonq}}, "input": $(json_prompt)}
JSON
)"
}

# Legacy API: deployment name in the path, api-version required, no "model".
do_legacy() {
  call POST {{.URLs.LegacyChatCompletions | shq}} "$(cat <<JSON
{"messages": [{"role": "user", "content": $(json_prompt)}]}
JSON
)"
}

case "${1:-{{if eq (print .WireAPI) "responses"}}responses{{else}}chat{{end}}}" in
  models)    do_models ;;
  chat)      do_chat ;;
  responses) do_responses ;;
  legacy)    do_legacy ;;
  all)       do_models; do_chat; do_responses; do_legacy ;;
  *) echo "usage: $0 [models|chat|responses|legacy|all]" >&2; exit 2 ;;
esac
{{- end}}
