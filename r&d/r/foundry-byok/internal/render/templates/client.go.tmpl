// authorize prefers an Entra ID bearer token (scope
// {{.EntraScope}}) and falls back to the resource key.
func authorize(h http.Header) error {
	if tok := os.Getenv(tokenEnv); tok != "" {
		h.Set("Authorization", "Bearer "+tok)
		return nil
	}
	if key := os.Getenv(keyEnv); key != "" {
		h.Set({{if eq .ClientKind "anthropic"}}"x-api-key"{{else}}"api-key"{{end}}, key)
		return nil
	}
	return errors.New("set " + tokenEnv + " or " + keyEnv)
}

func ask(ctx context.Context, prompt string) (string, error) {
	body, err := json.Marshal(newRequest(prompt))
	if err != nil {
		return "", err
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
	if err != nil {
		return "", err
	}
	req.Header.Set("Content-Type", "application/json")
{{- if eq .ClientKind "anthropic"}}
	req.Header.Set("anthropic-version", "2023-06-01")
{{- end}}
	if err := authorize(req.Header); err != nil {
		return "", err
	}

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()

	raw, err := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
	if err != nil {
		return "", err
	}
	if resp.StatusCode != http.StatusOK {
		if len(raw) > 2048 {
			raw = raw[:2048]
		}
		return "", fmt.Errorf("%s: %s (x-request-id %s)", resp.Status, bytes.TrimSpace(raw), resp.Header.Get("x-request-id"))
	}
	var out response
	if err := json.Unmarshal(raw, &out); err != nil {
		return "", fmt.Errorf("decode response: %w", err)
	}
	return out.text(), nil
}

func main() {
	prompt := "Reply with the single word: pong"
	if len(os.Args) > 1 {
		prompt = strings.Join(os.Args[1:], " ")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()

	text, err := ask(ctx, prompt)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
	fmt.Println(text)
}
