# Generated by foundry-byok. Do not edit; change the inventory and regenerate.
#
# Local GitHub Copilot CLI BYOK settings for Azure AI Foundry deployment
# {{.Spec.Deployment | shq}} ({{or .Spec.Environment "-"}}). Use it to reproduce, on a workstation, exactly
# what a gh-aw workflow sends:
#
#   source copilot-cli.env && copilot
#
# This file holds no secret. The key is read from your shell at source time.
{{- range .WarningsFor "gh-aw"}}
# WARNING: {{.}}
{{- end}}

export COPILOT_PROVIDER_BASE_URL={{.Client.CLIBaseURL | shq}}
export COPILOT_MODEL={{.Client.CLIModel | shq}}
{{- if .GhAw.ProviderType}}
export COPILOT_PROVIDER_TYPE={{.GhAw.ProviderType | shq}}
{{- end}}
{{- if .GhAw.ProviderModelID}}
# Deployment name differs from the model ID. COPILOT_PROVIDER_MODEL_ID is
# documented in the gh-aw engines reference; if your CLI build ignores it,
# set COPILOT_MODEL to the deployment name instead.
export COPILOT_PROVIDER_MODEL_ID={{.GhAw.ProviderModelID | shq}}
{{- end}}
{{- if eq (print .GhAw.WireAPI) "responses"}}
export COPILOT_PROVIDER_WIRE_API='responses'
{{- end}}

if [ -n "${AZURE_FOUNDRY_BEARER_TOKEN:-}" ]; then
  # Entra ID: az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
  export COPILOT_PROVIDER_BEARER_TOKEN="${AZURE_FOUNDRY_BEARER_TOKEN}"
else
  export COPILOT_PROVIDER_API_KEY="{{shvar .KeyEnv (print ":?export " .KeyEnv " or AZURE_FOUNDRY_BEARER_TOKEN first")}}"
fi
{{- if .Client.CLIAzureBaseURL}}

# Alternative: the CLI's native Azure provider type. Base URL is the resource
# root and COPILOT_MODEL is the *deployment* name. (The GHEC edition of the docs
# shows {{.URLs.LegacyDeploymentBase}} as the base URL instead;
# try that if the root is rejected.) The OpenAI-compatible /openai/v1 form
# above is what gh-aw and the Copilot SDK document for Foundry, so prefer it.
#
#   export COPILOT_PROVIDER_TYPE='azure'
#   export COPILOT_PROVIDER_BASE_URL={{.Client.CLIAzureBaseURL | shq}}
#   export COPILOT_MODEL={{.Spec.Deployment | shq}}
#   unset COPILOT_PROVIDER_MODEL_ID COPILOT_PROVIDER_WIRE_API
{{- end}}
