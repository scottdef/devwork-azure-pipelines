<!--
  The AI gateway. An app calls it with its own Entra ID token and never
  holds a model key:

    1. the token is checked (cool-jwt)
    2. the app's token budget is applied (cool-ai-budget)
    3. token use is recorded as a metric, by caller and budget
    4. API Management signs in to Microsoft Foundry with its own identity
       and forwards the request

  The instance's identity needs the role "Cognitive Services OpenAI User" on
  the Foundry account. cool-infra assigns it.
-->
<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="cool-jwt" />
    <include-fragment fragment-id="cool-ai-budget" />
    <llm-emit-token-metric namespace="cool-ai">
      <dimension name="caller" value='@((string)context.Variables["cool-ai-caller"])' />
      <dimension name="budget" value='@((string)context.Variables["cool-ai-budget"])' />
      <dimension name="API ID" />
    </llm-emit-token-metric>
    <set-backend-service backend-id="cool-foundry" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <set-query-parameter name="api-version" exists-action="skip">
      <value>2024-10-21</value>
    </set-query-parameter>
  </inbound>
  <backend>
    <!-- Model answers stream; do not buffer them. -->
    <forward-request timeout="120" buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
