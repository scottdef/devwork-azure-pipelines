{
  "uid": "cool-[[.Team]]-[[.App]]-[[.Environment]]",
  "title": "[[.Team]] / [[.App]] ([[.Environment]])",
  "tags": ["cooldeploy", "[[.Team]]", "[[.Environment]]"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "current": {}}
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Releases",
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "iconColor": "blue",
        "type": "tags",
        "tags": ["cool-release", "[[.Namespace]]"]
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second, by release",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{destination_workload}}",
         "expr": "sum by (destination_workload) (rate(istio_requests_total{destination_workload_namespace=\"[[.Namespace]]\"}[5m]))"}
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Share of 5xx responses, by release",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{destination_workload}}",
         "expr": "sum by (destination_workload) (rate(istio_requests_total{destination_workload_namespace=\"[[.Namespace]]\",response_code=~\"5..\"}[5m])) / sum by (destination_workload) (rate(istio_requests_total{destination_workload_namespace=\"[[.Namespace]]\"}[5m]))"}
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Request duration, p50 and p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p50",
         "expr": "histogram_quantile(0.50, sum by (le) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=\"[[.Namespace]]\"}[5m])))"},
        {"refId": "B", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=\"[[.Namespace]]\"}[5m])))"}
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Share of traffic, by release",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 30, "stacking": {"mode": "normal"}}}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{destination_workload}}",
         "expr": "sum by (destination_workload) (rate(istio_requests_total{destination_workload_namespace=\"[[.Namespace]]\"}[5m])) / ignoring(destination_workload) group_left sum(rate(istio_requests_total{destination_workload_namespace=\"[[.Namespace]]\"}[5m]))"}
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Available replicas, by release",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{deployment}}",
         "expr": "kube_deployment_status_replicas_available{namespace=\"[[.Namespace]]\"}"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "CPU cores in use, by pod",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{pod}}",
         "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"[[.Namespace]]\",container=\"app\"}[5m]))"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Memory in use, by pod",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{pod}}",
         "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"[[.Namespace]]\",container=\"app\"})"}
      ]
    }
  ]
}
