# Copy to ~/.config/p340/env and chmod 600. Read by the systemd user units.
# Generate keys with: openssl rand -hex 24

GATE_KEY=change-me
STRATA_API_KEY=change-me
LLAMA_API_KEY=change-me

# The one weight file both engines serve. Find it after downloading in
# Unsloth Studio with:
#   find ~/.cache/huggingface/hub -name '*UD-Q4_K_XL*.gguf'
BRAIN_GGUF=/home/you/.cache/huggingface/hub/models--unsloth--Qwen3.6-35B-A3B-MTP-GGUF/snapshots/REV/FILE.gguf

# Embedding model for the embed alias (any embedding GGUF).
EMBED_GGUF=/home/you/models/embeddinggemma-300m-Q8_0.gguf

# llama-server built for Pascal (see README, "llama-server for the P1000").
LLAMA_SERVER=/home/you/llama.cpp/build/bin/llama-server
