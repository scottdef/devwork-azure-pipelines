{{define "feed.xml.tmpl"}}<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>CoolGitOrg library</title>
  <subtitle>Items published from IssueOps requests</subtitle>
  <id>{{xml .BaseURL}}</id>
  <link rel="alternate" type="text/html" href="{{xml .BaseURL}}"/>
  <link rel="self" type="application/atom+xml" href="{{xml .BaseURL}}feed.xml"/>
  <updated>{{dateFmt "rfc3339" .Now}}</updated>
  <author><name>issueops-library</name></author>
  <generator version="{{xml .Version}}">pagegen</generator>
{{- range $i, $e := .Entries}}{{if lt $i 50}}
  <entry>
    <title>{{xml $e.SourceID}} {{xml $e.TemplateID}} (phase {{$e.Phase}})</title>
    <id>{{xml $e.URL}}</id>
    <link rel="alternate" type="text/html" href="{{xml $e.URL}}"/>
    <link rel="enclosure" href="{{xml $e.URL}}bundle.tar.gz" type="application/gzip"/>
    <published>{{dateFmt "rfc3339" $e.PublishedAt}}</published>
    <updated>{{dateFmt "rfc3339" $e.PublishedAt}}</updated>
    <category term="{{xml $e.TemplateID}}"/>
    <summary>{{xml $e.ID}}: {{xml $e.ArtifactFile.Name}} ({{humanSize $e.ArtifactFile.Size}}), sha256 {{$e.ArtifactFile.SHA256}}</summary>
  </entry>
{{- end}}{{end}}
</feed>
{{end}}
