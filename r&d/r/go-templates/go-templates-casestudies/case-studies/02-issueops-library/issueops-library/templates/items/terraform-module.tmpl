#!tmpl ext=tf
# {{.name}}: Terraform module, phase {{._.phase}} of {{._.item_id}}
terraform {
  required_version = ">= 1.6"
}

variable "name" {
  type    = string
  default = {{quote .name}}
}

variable "cidr" {
  type    = string
  default = {{quote (.cidr | default "10.0.0.0/16")}}
}

variable "tags" {
  type = map(string)
  default = {
    "source"  = {{quote ._.source_id}}
    "library" = {{quote ._.item_id}}
{{- range $k, $v := .tags}}
    {{quote $k}} = {{quote (printf "%v" $v)}}
{{- end}}
  }
}

locals {
  subnets = [{{range $i, $s := (.subnets | default (list 1 2))}}{{if $i}}, {{end}}cidrsubnet(var.cidr, 8, {{$s}}){{end}}]
}

output "subnets" {
  value = local.subnets
}
