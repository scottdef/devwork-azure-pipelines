// Command [[ .Name ]]-parse turns the body of a "[[ .Title ]]" issue (a
// GitHub issue form) into JSON on standard output. Generated by
// tmplforge new issueops [[ .Name ]]; standard library only.
//
//	printf '%s' "$ISSUE_BODY" | go run ./cmd/[[ .Name ]]-parse [-dispatch event]
//
// With -dispatch the JSON is a repository_dispatch request body:
// {"event_type": event, "client_payload": {...}}. Validation errors are
// written to standard error as a Markdown list and the exit status is 1.
package main

import (
	"bufio"
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
)

type field struct {
	id, label, typ string
	options        []string
	required       bool
}

var fields = []field{
[[- range .Fields ]]
	{id: [[ printf "%q" .ID ]], label: [[ printf "%q" .Label ]], typ: [[ printf "%q" .Type ]], options: [[ if .Options ]][]string{[[ range $i, $o := .Options ]][[ if $i ]], [[ end ]][[ printf "%q" $o ]][[ end ]]}[[ else ]]nil[[ end ]], required: [[ .Required ]]},
[[- end ]]
}

func main() {
	dispatch := flag.String("dispatch", "", "wrap the result as a repository_dispatch body with this event_type")
	flag.Parse()
	body, err := io.ReadAll(io.LimitReader(os.Stdin, 1<<20))
	if err != nil {
		fmt.Fprintln(os.Stderr, "- cannot read issue body:", err)
		os.Exit(1)
	}
	out, errs := parse(string(body))
	if len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintf(os.Stderr, "- %s\n", e)
		}
		os.Exit(1)
	}
	var v any = out
	if *dispatch != "" {
		v = map[string]any{"event_type": *dispatch, "client_payload": out}
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(v); err != nil {
		fmt.Fprintln(os.Stderr, "-", err)
		os.Exit(1)
	}
}

// sections splits an issue-form body into "### Label" -> value.
func sections(body string) map[string]string {
	m := map[string]string{}
	var cur string
	var buf []string
	flush := func() {
		if cur != "" {
			m[cur] = strings.TrimSpace(strings.Join(buf, "\n"))
		}
	}
	sc := bufio.NewScanner(strings.NewReader(strings.ReplaceAll(body, "\r\n", "\n")))
	sc.Buffer(make([]byte, 64<<10), 1<<20)
	for sc.Scan() {
		line := sc.Text()
		if strings.HasPrefix(line, "### ") {
			flush()
			cur, buf = strings.TrimSpace(line[4:]), nil
			continue
		}
		buf = append(buf, line)
	}
	flush()
	return m
}

func parse(body string) (map[string]any, []string) {
	s := sections(body)
	out := map[string]any{}
	var errs []string
	for _, f := range fields {
		raw := s[f.label]
		if raw == "_No response_" || raw == "None" {
			raw = ""
		}
		switch {
		case f.typ == "bool":
			out[f.id] = strings.Contains(strings.ToLower(raw), "- [x]")
		case raw == "":
			if f.required {
				errs = append(errs, fmt.Sprintf("**%s** is required", f.label))
			}
		case f.typ == "int":
			n, err := strconv.Atoi(raw)
			if err != nil {
				errs = append(errs, fmt.Sprintf("**%s**: %q is not a whole number", f.label, raw))
				continue
			}
			out[f.id] = n
		case f.typ == "dropdown":
			ok := false
			for _, o := range f.options {
				ok = ok || o == raw
			}
			if !ok {
				errs = append(errs, fmt.Sprintf("**%s**: %q is not one of %s", f.label, raw, strings.Join(f.options, ", ")))
				continue
			}
			out[f.id] = raw
		default:
			out[f.id] = raw
		}
	}
	return out, errs
}
