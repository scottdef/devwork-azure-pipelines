[[- /* Shared fragments for the CI/CD generators. Data: {C: CICD, Targets}. */ -]]
[[- define "dispatch-inputs" ]]
  workflow_dispatch:
[[- with .C.Inputs ]]
    inputs:
[[- range . ]]
      [[ .Name ]]:
        description: [[ toJSON .Description ]]
        type: [[ .Type ]]
        required: [[ .Required ]]
[[- if .Default ]]
        default: [[ .DefaultYAML ]]
[[- end ]]
[[- with .Options ]]
        options: [[ toJSON . ]]
[[- end ]]
[[- end ]]
[[- end ]]
[[- end ]]

[[- define "input-env" ]]
[[- range .C.Inputs ]]
          [[ .EnvName ]]: ${{ inputs.[[ .Name ]] }}
[[- end ]]
[[- end ]]

[[- define "setup-go" ]]
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version: ${{ vars.GO_VERSION || '[[ .C.Go ]]' }}
[[- end ]]
