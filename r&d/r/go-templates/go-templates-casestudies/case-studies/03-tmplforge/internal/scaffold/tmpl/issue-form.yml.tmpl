# Generated by tmplforge new issueops [[ .Name ]]. Parsed by
# .github/workflows/[[ .Name ]]-parse.yml via cmd/[[ .Name ]]-parse.
name: [[ .Title | toJSON ]]
description: [[ printf "IssueOps request: %s" .Title | toJSON ]]
title: [[ printf "[%s] " .Name | toJSON ]]
labels: [[ list .Name "issueops" | toJSON ]]
body:
  - type: markdown
    attributes:
      value: "Fill in every field. A bot parses this issue; edit it to re-run validation."
[[- range .Fields ]]
  - type: [[ .FormType ]]
    id: [[ .ID ]]
    attributes:
      label: [[ .Label | toJSON ]]
[[- if eq .Type "dropdown" ]]
      options: [[ toJSON .Options ]]
[[- else if eq .Type "bool" ]]
      options:
        - label: "Yes"
[[- else if eq .Type "int" ]]
      description: "A whole number."
[[- end ]]
[[- if ne .Type "bool" ]]
    validations:
      required: [[ .Required ]]
[[- end ]]
[[- end ]]
