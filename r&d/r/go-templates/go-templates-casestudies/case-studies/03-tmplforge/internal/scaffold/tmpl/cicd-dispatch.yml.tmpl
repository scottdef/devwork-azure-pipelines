# Generated by tmplforge new cicd dispatch.
# Inputs reach the shell only as environment variables (INPUT_*), never by
# ${{ }} interpolation into run:, so no input can inject shell syntax.
name: [[ .C.Name ]]

on:
[[- template "dispatch-inputs" . ]]

permissions:
  contents: read

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
[[- template "setup-go" . ]]
      - name: run [[ .C.Binary ]]
        env:
[[- template "input-env" . ]]
        run: |
          {
            echo "## [[ .C.Name ]]"
            echo
            echo '| input | value |'
            echo '|---|---|'
[[- range .C.Inputs ]]
            printf '| [[ .Name ]] | %s |\n' "$[[ .EnvName ]]"
[[- end ]]
          } >> "$GITHUB_STEP_SUMMARY"
          go run ./cmd/[[ .C.Binary ]]
