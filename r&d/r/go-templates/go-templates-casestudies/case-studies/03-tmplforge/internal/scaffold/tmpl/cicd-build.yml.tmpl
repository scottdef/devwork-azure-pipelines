# Generated by tmplforge new cicd build.
name: [[ .C.Name ]]

on:
  push:
    branches: [main]
  pull_request:
[[- template "dispatch-inputs" . ]]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
[[- template "setup-go" . ]]
      - run: go vet ./...
      - run: test -z "$(gofmt -l .)"
      - run: go test -race ./...
  cross:
    needs: test
    runs-on: ubuntu-latest
    strategy:
      matrix:
        include:
[[- range .Targets ]]
          - { goos: [[ .OS ]], goarch: [[ .Arch ]] }
[[- end ]]
    steps:
[[- template "setup-go" . ]]
      - name: build ${{ matrix.goos }}/${{ matrix.goarch }}
        env:
          GOOS: ${{ matrix.goos }}
          GOARCH: ${{ matrix.goarch }}
          CGO_ENABLED: "0"
[[- template "input-env" . ]]
        run: go build -trimpath -ldflags="-s -w" -o "dist/[[ .C.Binary ]]-$GOOS-$GOARCH" ./cmd/[[ .C.Binary ]]
