# Generated by tmplforge new cicd repository_dispatch.
# Send an event (needs a token that may write to this repository):
#   gh api repos/OWNER/REPO/dispatches -f event_type=[[ index .C.Types 0 ]] [[- range .C.Inputs ]] -f 'client_payload[[ printf "[%s]" .Name ]]=...'[[- end ]]
name: [[ .C.Name ]]

on:
  repository_dispatch:
    types: [[ toJSON .C.Types ]]

permissions:
  contents: read

jobs:
  handle:
    runs-on: ubuntu-latest
    steps:
[[- template "setup-go" . ]]
      - name: handle ${{ github.event.action }}
        env:
          EVENT: ${{ github.event.action }}
[[- range .C.Inputs ]]
          [[ .EnvName ]]: ${{ github.event.client_payload.[[ .Name ]] }}
[[- end ]]
        run: |
          printf 'event=%s\n' "$EVENT"
[[- range .C.Inputs ]]
          printf '[[ .Name ]]=%s\n' "$[[ .EnvName ]]"
[[- end ]]
          go run ./cmd/[[ .C.Binary ]]
