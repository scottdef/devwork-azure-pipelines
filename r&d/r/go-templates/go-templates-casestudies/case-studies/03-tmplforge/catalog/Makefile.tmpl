# Generated by tmplforge. Recipes are indented with tabs.
BIN = {{ .binary }}
VERSION ?= {{ .version }}
LDFLAGS = -s -w -X main.version=$(VERSION)

all: build

build:
	CGO_ENABLED=0 go build -trimpath -ldflags="$(LDFLAGS)" -o bin/$(BIN) ./cmd/$(BIN)
{{ range .targets }}
{{ .os }}-{{ .arch }}:
	CGO_ENABLED=0 GOOS={{ .os }} GOARCH={{ .arch }} go build -trimpath -ldflags="$(LDFLAGS)" -o dist/$(BIN)-{{ .os }}-{{ .arch }} ./cmd/$(BIN)
{{ end }}
cross:{{ range .targets }} {{ .os }}-{{ .arch }}{{ end }}

clean:
	rm -rf bin dist

.PHONY: all build cross clean{{ range .targets }} {{ .os }}-{{ .arch }}{{ end }}
