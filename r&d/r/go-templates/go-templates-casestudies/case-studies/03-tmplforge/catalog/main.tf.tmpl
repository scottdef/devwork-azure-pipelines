# Generated by tmplforge from catalog/main.tf.tmpl
{{- range .repos }}

resource "github_repository" {{ .name | replace "." "_" | printf "%q" }} {
  name                   = {{ printf "%q" .name }}
  description            = {{ printf "%q" .description }}
  visibility             = {{ printf "%q" (default "internal" .visibility) }}
  has_issues             = true
  delete_branch_on_merge = true
  topics                 = {{ .topics | toJSON }}
}

resource "github_repository_ruleset" {{ printf "%s_main" (.name | replace "." "_") | printf "%q" }} {
  name        = "main"
  repository  = github_repository.{{ .name | replace "." "_" }}.name
  target      = "branch"
  enforcement = "active"

  conditions {
    ref_name {
      include = ["~DEFAULT_BRANCH"]
      exclude = []
    }
  }

  rules {
    deletion         = true
    non_fast_forward = true
    pull_request {
      required_approving_review_count = {{ default 1 .reviews }}
    }
  }
}
{{- end }}
