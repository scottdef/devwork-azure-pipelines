<svg xmlns="http://www.w3.org/2000/svg" width="{{ mul (len .points) .step }}" height="{{ .height }}" viewBox="0 0 {{ mul (len .points) .step }} {{ .height }}" role="img" aria-label="{{ .label }}">
<title>{{ .label }}</title>
<polyline fill="none" stroke="{{ .color }}" stroke-width="2" points="{{ range $i, $p := .points }}{{ if $i }} {{ end }}{{ mul $i $.step }},{{ sub $.height $p }}{{ end }}"/>
</svg>
