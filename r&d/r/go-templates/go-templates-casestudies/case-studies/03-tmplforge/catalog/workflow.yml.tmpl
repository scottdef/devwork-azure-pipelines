# Generated by tmplforge from catalog/workflow.yml.tmpl
name: [[ .name ]]

on:
  push:
    branches: [[ .branches | toJSON ]]
  pull_request:

permissions:
  contents: read

jobs:
  build:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [[ .os | toJSON ]]
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version: ${{ vars.GO_VERSION || '[[ .go ]]' }}
[[- range .steps ]]
      - name: [[ .name | toJSON ]]
        run: [[ .run | toJSON ]]
[[- end ]]
