# Generated by tmplforge. Recipes are indented with tabs.
BIN = tmplforge
VERSION ?= 0.1.0
LDFLAGS = -s -w -X main.version=$(VERSION)

all: build

build:
	CGO_ENABLED=0 go build -trimpath -ldflags="$(LDFLAGS)" -o bin/$(BIN) ./cmd/$(BIN)

linux-amd64:
	CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="$(LDFLAGS)" -o dist/$(BIN)-linux-amd64 ./cmd/$(BIN)

linux-arm64:
	CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="$(LDFLAGS)" -o dist/$(BIN)-linux-arm64 ./cmd/$(BIN)

plan9-amd64:
	CGO_ENABLED=0 GOOS=plan9 GOARCH=amd64 go build -trimpath -ldflags="$(LDFLAGS)" -o dist/$(BIN)-plan9-amd64 ./cmd/$(BIN)

cross: linux-amd64 linux-arm64 plan9-amd64

clean:
	rm -rf bin dist

.PHONY: all build cross clean linux-amd64 linux-arm64 plan9-amd64
